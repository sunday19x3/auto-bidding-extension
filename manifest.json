{
  "manifest_version": 3,
  "name": "Auto Bidding",
  "version": "1.0",
  "description": "Automatically place bids on items in online auctions",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "scripting"],
  "content_scripts": [
    {
      "js": ["scripts/content.js"],
      "matches": [
        "*://*/egp/bidonlinefe/reoffer-onl-proposals/*"
      ]
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "24": "icons/icon24.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html"
  }
}

{
  "manifest_version": 3,
  "name": "Auto Bidding",
  "version": "1.0",
  "description": "Automatically place bids on items in online auctions",
  "permissions": ["activeTab", "scripting"],
  "content_scripts": [
    {
      "js": ["scripts/content.js"],
      "matches": [
        "*://*/egp/bidonlinefe/reoffer-onl-proposals/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
